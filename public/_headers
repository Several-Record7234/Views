/*.html
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Access-Control-Allow-Origin: https://www.owlbear.rodeo
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'self'; worker-src 'self'; media-src 'none'; frame-src 'none'; object-src 'none';
